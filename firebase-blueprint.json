{
  "entities": {
    "Vehicle": {
      "title": "Vehicle",
      "description": "A vehicle listing in the Alif Car Import / Alif Car Portal catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "make": { "type": "string" },
        "model": { "type": "string" },
        "year": { "type": "integer" },
        "price": { "type": "integer" },
        "originalPrice": { "type": "integer" },
        "mileage": { "type": "string" },
        "transmission": { "type": "string" },
        "fuelType": { "type": "string" },
        "color": { "type": "string" },
        "origin": { "type": "string" },
        "imageUrl": { "type": "string" },
        "galleryImages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "description": { "type": "string" },
        "tiktokUrl": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["available", "reserved", "sold"]
        },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "title",
        "make",
        "model",
        "year",
        "price",
        "mileage",
        "transmission",
        "fuelType",
        "color",
        "origin",
        "imageUrl",
        "description",
        "tiktokUrl",
        "status",
        "featured",
        "createdAt",
        "updatedAt"
      ]
    },
    "ShowroomConfig": {
      "title": "ShowroomConfig",
      "description": "Website branding, hero banner, TikTok showcase section, and contact/social info.",
      "type": "object",
      "properties": {
        "branding": { "type": "object" },
        "hero": { "type": "object" },
        "tiktok": { "type": "object" },
        "contact": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["branding", "hero", "tiktok", "contact", "updatedAt"]
    },
    "AdminAccessConfig": {
      "title": "AdminAccessConfig",
      "description": "Allowlist of additional admin email addresses.",
      "type": "object",
      "properties": {
        "adminEmails": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["adminEmails", "updatedAt"]
    },
    "SecurityConfig": {
      "title": "SecurityConfig",
      "description": "Global admin session cutoff timestamp enforced by Firestore security rules so Sign Out All Devices immediately blocks even pre-update apps and browser tabs.",
      "type": "object",
      "properties": {
        "forceSignOutBefore": { "type": "string", "format": "date-time" },
        "triggeredByEmail": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["forceSignOutBefore", "triggeredByEmail", "updatedAt"]
    },
    "AuthenticatorConfig": {
      "title": "AuthenticatorConfig",
      "description": "Google Authenticator (TOTP 2FA) configuration protecting active device removal, global sign-out, password changes, and 2FA disabling across all admin devices.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "secretBase32": { "type": "string" },
        "accountLabel": { "type": "string" },
        "issuer": { "type": "string" },
        "updatedByEmail": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["enabled", "secretBase32", "accountLabel", "issuer", "updatedByEmail", "updatedAt"]
    },
    "TikTokPost": {
      "title": "TikTokPost",
      "description": "TikTok walkaround post displayed on the showroom portal.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "caption": { "type": "string" },
        "tiktokUrl": { "type": "string" },
        "coverImageUrl": { "type": "string" },
        "sortOrder": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "caption", "tiktokUrl", "coverImageUrl", "sortOrder", "updatedAt"]
    },
    "CustomerInquiry": {
      "title": "CustomerInquiry",
      "description": "Customer inquiry lead submitted from the website.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "vehicleTitle": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "phone", "vehicleTitle", "message", "createdAt"]
    },
    "AdminSession": {
      "title": "AdminSession",
      "description": "Active or revoked admin login session synced across mobile app and website admin portal. Clients submit FieldValue.serverTimestamp() for createdAt and updatedAt.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "deviceId": { "type": "string" },
        "deviceName": { "type": "string" },
        "platform": { "type": "string" },
        "email": { "type": "string" },
        "location": { "type": "string" },
        "loginAtMillis": { "type": "integer" },
        "lastActiveMillis": { "type": "integer" },
        "status": {
          "type": "string",
          "enum": ["active", "revoked"]
        },
        "userAgent": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "uid",
        "deviceId",
        "deviceName",
        "platform",
        "email",
        "location",
        "loginAtMillis",
        "lastActiveMillis",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "LoginAlert": {
      "title": "LoginAlert",
      "description": "Security notification record created on admin sign-in so admins can confirm or immediately revoke unrecognized access. Clients submit FieldValue.serverTimestamp() for createdAt and updatedAt.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "deviceName": { "type": "string" },
        "platform": { "type": "string" },
        "location": { "type": "string" },
        "timestampMillis": { "type": "integer" },
        "decision": {
          "type": "string",
          "enum": ["pending", "confirmed_me", "rejected_not_me"]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "sessionId",
        "uid",
        "email",
        "deviceName",
        "platform",
        "location",
        "timestampMillis",
        "decision",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminLoginAttempt": {
      "title": "AdminLoginAttempt",
      "description": "Unauthorized or failed attempt to log into the Admin Page (web /admin or admin app). Append-only create with admin-only read.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "deviceName": { "type": "string" },
        "platform": { "type": "string" },
        "sourcePage": { "type": "string" },
        "location": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["failed", "denied", "attempt"]
        },
        "browser": { "type": "string" },
        "reason": { "type": "string" },
        "timestampMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "email",
        "deviceName",
        "platform",
        "sourcePage",
        "location",
        "status",
        "timestampMillis",
        "createdAt"
      ]
    },
    "PageVisit": {
      "title": "PageVisit",
      "description": "Silent visitor count entry for the public website home/dashboard page displayed in admin Settings.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "page": { "type": "string" },
        "visitorId": { "type": "string" },
        "dateKey": { "type": "string" },
        "referrer": { "type": "string" },
        "userAgent": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "page", "createdAt"]
    },
    "SiteVisitorStats": {
      "title": "SiteVisitorStats",
      "description": "Aggregated website visitor counters incremented by +1 per visit and readable only by verified admins.",
      "type": "object",
      "properties": {
        "totalVisits": { "type": "integer" },
        "uniqueVisitors": { "type": "integer" },
        "todayVisits": { "type": "integer" },
        "todayKey": { "type": "string" },
        "lastPage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["totalVisits", "updatedAt"]
    }
  },
  "firestore": {
    "/vehicles/{vehicleId}": {
      "schema": { "$ref": "#/entities/Vehicle" },
      "description": "Publicly readable, admin-writable Alif Car Portal vehicle inventory."
    },
    "/config/showroom": {
      "schema": { "$ref": "#/entities/ShowroomConfig" },
      "description": "Showroom branding, hero, TikTok config, and full contact/social media links."
    },
    "/config/adminAccess": {
      "schema": { "$ref": "#/entities/AdminAccessConfig" },
      "description": "Admin email allowlist."
    },
    "/config/security": {
      "schema": { "$ref": "#/entities/SecurityConfig" },
      "description": "Global forceSignOutBefore cutoff enforced server-side against auth_time."
    },
    "/config/authenticator": {
      "schema": { "$ref": "#/entities/AuthenticatorConfig" },
      "description": "Admin-only Google Authenticator (TOTP 2FA) protection state and secret."
    },
    "/tiktokPosts/{postId}": {
      "schema": { "$ref": "#/entities/TikTokPost" },
      "description": "Showroom TikTok walkaround showcase posts."
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/CustomerInquiry" },
      "description": "Customer inquiries submitted on the website."
    },
    "/adminSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/AdminSession" },
      "description": "Active and revoked admin device sessions across web and mobile."
    },
    "/loginAlerts/{alertId}": {
      "schema": { "$ref": "#/entities/LoginAlert" },
      "description": "Real-time admin page sign-in alerts for confirming or blocking devices."
    },
    "/adminLoginAttempts/{attemptId}": {
      "schema": { "$ref": "#/entities/AdminLoginAttempt" },
      "description": "Failed or unauthorized attempts to log into the admin page."
    },
    "/pageVisits/{visitId}": {
      "schema": { "$ref": "#/entities/PageVisit" },
      "description": "Individual website dashboard/home visitor records for Settings analytics."
    },
    "/siteStats/{statId}": {
      "schema": { "$ref": "#/entities/SiteVisitorStats" },
      "description": "Aggregated website visitor totals (document ID: visitors)."
    }
  }
}
