{
  "entities": {
    "Vehicle": {
      "title": "Vehicle",
      "description": "A vehicle listing in the Alif Car Import / Alif Car Portal catalog.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document ID matching /vehicles/{vehicleId}."
        },
        "title": {
          "type": "string",
          "description": "Listing headline (1-200 chars)."
        },
        "make": {
          "type": "string",
          "description": "Manufacturer (1-80 chars)."
        },
        "model": {
          "type": "string",
          "description": "Model name (1-120 chars)."
        },
        "year": {
          "type": "integer",
          "description": "Model year (1950-2100)."
        },
        "price": {
          "type": "integer",
          "description": "Asking price in USD (0-100,000,000)."
        },
        "originalPrice": {
          "type": "integer",
          "description": "Optional pre-discount price in USD."
        },
        "mileage": {
          "type": "string",
          "description": "Odometer reading string (0-60 chars)."
        },
        "transmission": {
          "type": "string",
          "description": "Transmission type (0-80 chars)."
        },
        "fuelType": {
          "type": "string",
          "description": "Fuel or powertrain type (0-80 chars)."
        },
        "color": {
          "type": "string",
          "description": "Exterior color (0-80 chars)."
        },
        "origin": {
          "type": "string",
          "description": "Import origin country/region (0-100 chars)."
        },
        "imageUrl": {
          "type": "string",
          "description": "Primary listing image URL or JPEG data URL (1-550,000 chars)."
        },
        "galleryImages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional additional gallery image URLs (up to 10)."
        },
        "description": {
          "type": "string",
          "description": "Vehicle listing description (1-4,000 chars)."
        },
        "tiktokUrl": {
          "type": "string",
          "description": "Optional TikTok walkaround URL (0-500 chars)."
        },
        "status": {
          "type": "string",
          "enum": ["available", "reserved", "sold"],
          "description": "Current lot availability status."
        },
        "featured": {
          "type": "boolean",
          "description": "Whether the vehicle is featured on the website."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable ISO-8601 creation timestamp string."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server-assigned last update timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "id",
        "title",
        "make",
        "model",
        "year",
        "price",
        "mileage",
        "transmission",
        "fuelType",
        "color",
        "origin",
        "imageUrl",
        "description",
        "tiktokUrl",
        "status",
        "featured",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/vehicles/{vehicleId}": {
      "schema": {
        "$ref": "#/entities/Vehicle"
      },
      "description": "Publicly readable, admin-writable Alif Car Portal vehicle inventory."
    }
  }
}
