rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrapOwnerIdentity() {
      return isVerifiedUser() &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == 'alifcarimports@gmail.com';
    }

    function isAdminIdentity() {
      return isVerifiedUser() && (
        isBootstrapOwnerIdentity() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/config/adminAccess) &&
          request.auth.token.email is string &&
          get(/databases/$(database)/documents/config/adminAccess).data.adminEmails is list &&
          request.auth.token.email.lower() in get(/databases/$(database)/documents/config/adminAccess).data.adminEmails
        )
      );
    }

    // Server-side global session cutoff: blocks even old, un-updated APKs and stale browser tabs
    // whose Firebase Auth login (auth_time) occurred before config/security.forceSignOutBefore.
    function isFreshAdminSession() {
      return !exists(/databases/$(database)/documents/config/security) ||
        !(get(/databases/$(database)/documents/config/security).data.forceSignOutBefore is timestamp) ||
        (
          ('auth_time' in request.auth.token) &&
          request.auth.token.auth_time is number &&
          ((request.auth.token.auth_time + 1) * 1000) > get(/databases/$(database)/documents/config/security).data.forceSignOutBefore.toMillis()
        );
    }

    function isBootstrapOwner() {
      return isBootstrapOwnerIdentity() && isFreshAdminSession();
    }

    function isAdmin() {
      return isAdminIdentity() && isFreshAdminSession();
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidTimestamp(val) {
      return val is timestamp && val <= request.time;
    }

    function optStr(m, k, maxLen) {
      let v = m.get(k, '');
      return v == null || (v is string && v.size() <= maxLen);
    }

    function isValidBranding(b) {
      return b is map &&
        b.keys().hasAll(['companyName', 'logoUrl', 'tagline']) &&
        b.keys().hasOnly(['companyName', 'logoUrl', 'tagline']) &&
        b.companyName is string && b.companyName.size() >= 1 && b.companyName.size() <= 120 &&
        b.logoUrl is string && b.logoUrl.size() <= 550000 &&
        b.tagline is string && b.tagline.size() <= 240;
    }

    function isValidHero(h) {
      return h is map &&
        h.keys().hasAll(['kicker', 'title', 'description', 'imageUrl', 'ctaLabel']) &&
        h.keys().hasOnly(['kicker', 'title', 'description', 'imageUrl', 'ctaLabel']) &&
        h.kicker is string && h.kicker.size() <= 120 &&
        h.title is string && h.title.size() >= 1 && h.title.size() <= 200 &&
        h.description is string && h.description.size() <= 1200 &&
        h.imageUrl is string && h.imageUrl.size() <= 550000 &&
        h.ctaLabel is string && h.ctaLabel.size() >= 1 && h.ctaLabel.size() <= 80;
    }

    function isValidTikTokConfig(t) {
      return t is map &&
        t.keys().hasAll(['title', 'description', 'profileUrl', 'handle']) &&
        t.keys().hasOnly(['title', 'description', 'profileUrl', 'handle']) &&
        t.title is string && t.title.size() >= 1 && t.title.size() <= 160 &&
        t.description is string && t.description.size() <= 1200 &&
        t.profileUrl is string && t.profileUrl.size() <= 500 &&
        t.handle is string && t.handle.size() <= 80;
    }

    function isValidContact(c) {
      return c is map &&
        c.keys().hasAll([
          'addressLine',
          'cityCountry',
          'hours',
          'phone',
          'whatsapp',
          'email',
          'mapsUrl',
          'landmarkNote'
        ]) &&
        c.keys().hasOnly([
          'addressLine',
          'cityCountry',
          'hours',
          'phone',
          'whatsapp',
          'telegram',
          'instagram',
          'facebook',
          'x',
          'youtube',
          'snapchat',
          'linkedin',
          'pinterest',
          'threads',
          'reddit',
          'viber',
          'imo',
          'wechat',
          'discord',
          'twitch',
          'website',
          'email',
          'mapsUrl',
          'landmarkNote'
        ]) &&
        c.addressLine is string && c.addressLine.size() <= 240 &&
        c.cityCountry is string && c.cityCountry.size() <= 160 &&
        c.hours is string && c.hours.size() <= 160 &&
        c.phone is string && c.phone.size() <= 60 &&
        c.whatsapp is string && c.whatsapp.size() <= 300 &&
        c.email is string && c.email.size() <= 254 &&
        c.mapsUrl is string && c.mapsUrl.size() <= 500 &&
        c.landmarkNote is string && c.landmarkNote.size() <= 240 &&
        optStr(c, 'telegram', 300) &&
        optStr(c, 'instagram', 300) &&
        optStr(c, 'facebook', 300) &&
        optStr(c, 'x', 300) &&
        optStr(c, 'youtube', 300) &&
        optStr(c, 'snapchat', 300) &&
        optStr(c, 'linkedin', 300) &&
        optStr(c, 'pinterest', 300) &&
        optStr(c, 'threads', 300) &&
        optStr(c, 'reddit', 300) &&
        optStr(c, 'viber', 300) &&
        optStr(c, 'imo', 300) &&
        optStr(c, 'wechat', 300) &&
        optStr(c, 'discord', 300) &&
        optStr(c, 'twitch', 300) &&
        optStr(c, 'website', 500);
    }

    function isValidShowroomConfig(data) {
      return data.keys().hasAll(['branding', 'hero', 'tiktok', 'contact', 'updatedAt']) &&
        data.keys().hasOnly(['branding', 'hero', 'tiktok', 'contact', 'updatedAt']) &&
        isValidBranding(data.branding) &&
        isValidHero(data.hero) &&
        isValidTikTokConfig(data.tiktok) &&
        isValidContact(data.contact) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidAdminAccessConfig(data) {
      return data.keys().hasAll(['adminEmails', 'updatedAt']) &&
        data.keys().hasOnly(['adminEmails', 'updatedAt']) &&
        data.adminEmails is list &&
        data.adminEmails.size() <= 20 &&
        (data.adminEmails.size() == 0 || (data.adminEmails[0] is string && data.adminEmails[0].size() <= 254)) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidSecurityConfig(data) {
      return data.keys().hasAll(['forceSignOutBefore', 'triggeredByEmail', 'updatedAt']) &&
        data.keys().hasOnly(['forceSignOutBefore', 'triggeredByEmail', 'updatedAt']) &&
        isValidTimestamp(data.forceSignOutBefore) &&
        isValidString(data.triggeredByEmail, 0, 254) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidAuthenticatorConfig(data) {
      return data.keys().hasAll([
          'enabled',
          'secretBase32',
          'accountLabel',
          'issuer',
          'updatedByEmail',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'enabled',
          'secretBase32',
          'accountLabel',
          'issuer',
          'updatedByEmail',
          'updatedAt'
        ]) &&
        data.enabled is bool &&
        data.secretBase32 is string &&
        (
          (data.enabled == true &&
            data.secretBase32.size() >= 16 &&
            data.secretBase32.size() <= 64 &&
            data.secretBase32.matches('^[A-Z2-7]+$')) ||
          (data.enabled == false && data.secretBase32 == '')
        ) &&
        isValidString(data.accountLabel, 0, 254) &&
        isValidString(data.issuer, 1, 120) &&
        isValidString(data.updatedByEmail, 0, 254) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidAdminMembership(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['email', 'role', 'createdAt']) &&
        isValidString(data.email, 3, 254) &&
        data.role == 'admin' &&
        isValidTimestamp(data.createdAt);
    }

    function isValidVehicle(vehicleId, data) {
      return data.keys().hasAll([
          'id',
          'title',
          'make',
          'model',
          'year',
          'price',
          'mileage',
          'transmission',
          'fuelType',
          'color',
          'origin',
          'imageUrl',
          'description',
          'tiktokUrl',
          'status',
          'featured',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'title',
          'make',
          'model',
          'year',
          'price',
          'originalPrice',
          'mileage',
          'transmission',
          'fuelType',
          'color',
          'origin',
          'imageUrl',
          'galleryImages',
          'description',
          'tiktokUrl',
          'status',
          'featured',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id == vehicleId &&
        isValidId(data.id) &&
        isValidString(data.title, 1, 200) &&
        isValidString(data.make, 1, 80) &&
        isValidString(data.model, 1, 120) &&
        data.year is number && data.year >= 1950 && data.year <= 2100 &&
        data.price is number && data.price >= 0 && data.price <= 100000000 &&
        (!('originalPrice' in data) || data.originalPrice == null || (data.originalPrice is number && data.originalPrice >= 0 && data.originalPrice <= 100000000)) &&
        isValidString(data.mileage, 0, 60) &&
        isValidString(data.transmission, 0, 80) &&
        isValidString(data.fuelType, 0, 80) &&
        isValidString(data.color, 0, 80) &&
        isValidString(data.origin, 0, 100) &&
        isValidString(data.imageUrl, 1, 550000) &&
        (!('galleryImages' in data) || data.galleryImages == null || (
          data.galleryImages is list &&
          data.galleryImages.size() <= 10 &&
          (data.galleryImages.size() == 0 || (data.galleryImages[0] is string && data.galleryImages[0].size() <= 550000))
        )) &&
        isValidString(data.description, 1, 4000) &&
        isValidString(data.tiktokUrl, 0, 500) &&
        data.status in ['available', 'reserved', 'sold'] &&
        data.featured is bool &&
        isValidString(data.createdAt, 1, 64) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidTikTokPost(postId, data) {
      return data.keys().hasAll(['id', 'title', 'caption', 'tiktokUrl', 'coverImageUrl', 'sortOrder', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'title', 'caption', 'tiktokUrl', 'coverImageUrl', 'sortOrder', 'updatedAt']) &&
        data.id == postId &&
        isValidId(data.id) &&
        isValidString(data.title, 0, 200) &&
        isValidString(data.caption, 0, 2000) &&
        isValidString(data.tiktokUrl, 0, 500) &&
        isValidString(data.coverImageUrl, 0, 550000) &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidInquiry(inquiryId, data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'vehicleTitle', 'message', 'createdAt']) &&
        data.keys().hasOnly(['id', 'name', 'phone', 'email', 'vehicleTitle', 'message', 'createdAt']) &&
        data.id == inquiryId &&
        isValidId(data.id) &&
        isValidString(data.name, 1, 120) &&
        isValidString(data.phone, 1, 40) &&
        (!('email' in data) || data.email == null || isValidString(data.email, 0, 254)) &&
        isValidString(data.vehicleTitle, 0, 200) &&
        isValidString(data.message, 1, 2000) &&
        isValidTimestamp(data.createdAt);
    }

    function isValidAdminSession(sessionId, data) {
      return data.keys().hasAll([
          'id',
          'uid',
          'deviceId',
          'deviceName',
          'platform',
          'email',
          'location',
          'loginAtMillis',
          'lastActiveMillis',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'uid',
          'deviceId',
          'deviceName',
          'platform',
          'email',
          'location',
          'loginAtMillis',
          'lastActiveMillis',
          'status',
          'userAgent',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id == sessionId &&
        isValidId(data.id) &&
        isValidString(data.uid, 1, 128) &&
        isValidString(data.deviceId, 1, 128) &&
        isValidString(data.deviceName, 1, 160) &&
        isValidString(data.platform, 1, 60) &&
        isValidString(data.email, 0, 254) &&
        isValidString(data.location, 1, 160) &&
        data.loginAtMillis is number && data.loginAtMillis >= 0 &&
        data.lastActiveMillis is number && data.lastActiveMillis >= 0 &&
        data.status in ['active', 'revoked'] &&
        (!('userAgent' in data) || data.userAgent == null || isValidString(data.userAgent, 0, 300)) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidLoginAlert(alertId, data) {
      return data.keys().hasAll([
          'id',
          'sessionId',
          'uid',
          'email',
          'deviceName',
          'platform',
          'location',
          'timestampMillis',
          'decision',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'sessionId',
          'uid',
          'email',
          'deviceName',
          'platform',
          'location',
          'timestampMillis',
          'decision',
          'sourcePage',
          'attemptType',
          'browser',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id == alertId &&
        isValidId(data.id) &&
        isValidId(data.sessionId) &&
        isValidString(data.uid, 1, 128) &&
        isValidString(data.email, 0, 254) &&
        isValidString(data.deviceName, 1, 160) &&
        isValidString(data.platform, 1, 60) &&
        isValidString(data.location, 1, 160) &&
        data.timestampMillis is number && data.timestampMillis >= 0 &&
        data.decision in ['pending', 'confirmed_me', 'rejected_not_me'] &&
        (!('sourcePage' in data) || data.sourcePage == null || isValidString(data.sourcePage, 0, 120)) &&
        (!('attemptType' in data) || data.attemptType == null || isValidString(data.attemptType, 0, 60)) &&
        (!('browser' in data) || data.browser == null || isValidString(data.browser, 0, 80)) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidAdminLoginAttempt(attemptId, data) {
      return data.keys().hasAll([
          'id',
          'email',
          'deviceName',
          'platform',
          'sourcePage',
          'location',
          'status',
          'timestampMillis',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'email',
          'deviceName',
          'platform',
          'sourcePage',
          'location',
          'status',
          'browser',
          'reason',
          'timestampMillis',
          'createdAt'
        ]) &&
        data.id == attemptId &&
        isValidId(data.id) &&
        isValidString(data.email, 0, 254) &&
        isValidString(data.deviceName, 1, 160) &&
        isValidString(data.platform, 1, 60) &&
        isValidString(data.sourcePage, 1, 120) &&
        data.sourcePage.lower().matches('.*admin.*') &&
        isValidString(data.location, 0, 160) &&
        data.status in ['failed', 'denied', 'attempt'] &&
        (!('browser' in data) || data.browser == null || isValidString(data.browser, 0, 80)) &&
        (!('reason' in data) || data.reason == null || isValidString(data.reason, 0, 240)) &&
        data.timestampMillis is number && data.timestampMillis >= 0 &&
        isValidTimestamp(data.createdAt);
    }

    function isValidPageVisit(visitId, data) {
      return data.keys().hasAll(['id', 'page', 'createdAt']) &&
        data.keys().hasOnly(['id', 'page', 'visitorId', 'dateKey', 'referrer', 'userAgent', 'createdAt']) &&
        data.id == visitId &&
        isValidId(data.id) &&
        isValidString(data.page, 1, 120) &&
        (!('visitorId' in data) || data.visitorId == null || isValidString(data.visitorId, 0, 128)) &&
        (!('dateKey' in data) || data.dateKey == null || isValidString(data.dateKey, 0, 20)) &&
        (!('referrer' in data) || data.referrer == null || isValidString(data.referrer, 0, 300)) &&
        (!('userAgent' in data) || data.userAgent == null || isValidString(data.userAgent, 0, 300)) &&
        isValidTimestamp(data.createdAt);
    }

    function isValidVisitorStatsDoc(data) {
      return data.keys().hasAll(['totalVisits', 'updatedAt']) &&
        data.keys().hasOnly(['totalVisits', 'uniqueVisitors', 'todayVisits', 'todayKey', 'lastPage', 'updatedAt']) &&
        data.totalVisits is number && data.totalVisits >= 0 && data.totalVisits <= 1000000000 &&
        (!('uniqueVisitors' in data) || data.uniqueVisitors == null || (data.uniqueVisitors is number && data.uniqueVisitors >= 0 && data.uniqueVisitors <= 1000000000)) &&
        (!('todayVisits' in data) || data.todayVisits == null || (data.todayVisits is number && data.todayVisits >= 0 && data.todayVisits <= 100000000)) &&
        (!('todayKey' in data) || data.todayKey == null || isValidString(data.todayKey, 0, 20)) &&
        (!('lastPage' in data) || data.lastPage == null || isValidString(data.lastPage, 0, 120)) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidVisitorStatsCreate(data) {
      return isValidVisitorStatsDoc(data) &&
        data.totalVisits == 1 &&
        (!('uniqueVisitors' in data) || data.uniqueVisitors == null || data.uniqueVisitors <= 1) &&
        (!('todayVisits' in data) || data.todayVisits == null || data.todayVisits <= 1);
    }

    function isValidVisitorStatsUpdate(prev, next) {
      return isValidVisitorStatsDoc(next) &&
        next.totalVisits == prev.totalVisits + 1 &&
        (
          !('uniqueVisitors' in next) || next.uniqueVisitors == null ||
          !('uniqueVisitors' in prev) || prev.uniqueVisitors == null ||
          next.uniqueVisitors == prev.uniqueVisitors ||
          next.uniqueVisitors == prev.uniqueVisitors + 1
        ) &&
        (
          !('todayVisits' in next) || next.todayVisits == null ||
          next.todayVisits == 1 ||
          ('todayVisits' in prev && prev.todayVisits is number && next.todayVisits == prev.todayVisits + 1)
        );
    }

    match /config/{configId} {
      allow get: if (
        configId == 'showroom' ||
        (configId == 'adminAccess' && isVerifiedUser() && isAdmin()) ||
        (configId == 'security' && isVerifiedUser() && isAdminIdentity()) ||
        (configId == 'authenticator' && isVerifiedUser() && isAdmin())
      );
      allow list: if false;
      allow create: if isAdmin() && (
        (configId == 'showroom' && isValidShowroomConfig(incoming())) ||
        (configId == 'adminAccess' && isValidAdminAccessConfig(incoming())) ||
        (configId == 'security' && isValidSecurityConfig(incoming())) ||
        (configId == 'authenticator' && isValidAuthenticatorConfig(incoming()))
      );
      allow update: if isAdmin() && (
        (configId == 'showroom' && isValidShowroomConfig(incoming())) ||
        (configId == 'adminAccess' && isValidAdminAccessConfig(incoming()) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['adminEmails', 'updatedAt'])) ||
        (configId == 'security' && isValidSecurityConfig(incoming()) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['forceSignOutBefore', 'triggeredByEmail', 'updatedAt'])) ||
        (configId == 'authenticator' && isValidAuthenticatorConfig(incoming()) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'enabled',
            'secretBase32',
            'accountLabel',
            'issuer',
            'updatedByEmail',
            'updatedAt'
          ]))
      );
      allow delete: if false;
    }

    match /admins/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && (request.auth.uid == uid || isBootstrapOwner());
      allow list: if isBootstrapOwner();
      allow create: if isValidId(uid) && isBootstrapOwner() && isValidAdminMembership(incoming());
      allow update: if isValidId(uid) && isBootstrapOwner() && isValidAdminMembership(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'role']);
      allow delete: if isValidId(uid) && isBootstrapOwner();
    }

    match /vehicles/{vehicleId} {
      allow get: if isValidId(vehicleId);
      allow list: if true;
      allow create: if isVerifiedUser() && isValidId(vehicleId) && isValidVehicle(vehicleId, incoming()) && isAdmin();
      allow update: if isVerifiedUser() && isValidId(vehicleId) && isValidVehicle(vehicleId, incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'make',
          'model',
          'year',
          'price',
          'originalPrice',
          'mileage',
          'transmission',
          'fuelType',
          'color',
          'origin',
          'imageUrl',
          'galleryImages',
          'description',
          'tiktokUrl',
          'status',
          'featured',
          'updatedAt'
        ]) && isAdmin();
      allow delete: if isVerifiedUser() && isValidId(vehicleId) && isAdmin();
    }

    match /tiktokPosts/{postId} {
      allow get: if isValidId(postId);
      allow list: if true;
      allow create: if isVerifiedUser() && isValidId(postId) && isValidTikTokPost(postId, incoming()) && isAdmin();
      allow update: if isVerifiedUser() && isValidId(postId) && isValidTikTokPost(postId, incoming()) &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'caption',
          'tiktokUrl',
          'coverImageUrl',
          'sortOrder',
          'updatedAt'
        ]) && isAdmin();
      allow delete: if isVerifiedUser() && isValidId(postId) && isAdmin();
    }

    match /inquiries/{inquiryId} {
      allow get: if isVerifiedUser() && isValidId(inquiryId) && isAdmin();
      allow list: if isBootstrapOwner();
      allow create: if isValidId(inquiryId) && isValidInquiry(inquiryId, incoming());
      allow update, delete: if false;
    }

    match /adminSessions/{sessionId} {
      allow get: if isVerifiedUser() && isValidId(sessionId) && isAdmin();
      allow list: if isVerifiedUser() && isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(sessionId) &&
        isValidAdminSession(sessionId, incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().status == 'active' &&
        isAdmin();
      allow update: if isVerifiedUser() &&
        isValidId(sessionId) &&
        isValidAdminSession(sessionId, incoming()) &&
        incoming().uid == existing().uid &&
        isAdmin() && (
          // Action 1: Any authorized admin can revoke a device session
          (
            incoming().id == existing().id &&
            incoming().deviceId == existing().deviceId &&
            incoming().createdAt == existing().createdAt &&
            incoming().status == 'revoked' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          // Action 2: Session owner refreshes heartbeat, location, or reactivates on re-login
          (
            existing().uid == request.auth.uid &&
            (!('id' in existing()) || incoming().id == existing().id) &&
            (!('deviceId' in existing()) || incoming().deviceId == existing().deviceId) &&
            (!('createdAt' in existing()) || !(existing().createdAt is timestamp) || incoming().createdAt == existing().createdAt) &&
            (
              incoming().diff(existing()).affectedKeys().hasOnly([
                'deviceName',
                'platform',
                'email',
                'location',
                'loginAtMillis',
                'lastActiveMillis',
                'status',
                'userAgent',
                'updatedAt'
              ]) ||
              !isValidAdminSession(sessionId, existing())
            )
          )
        );
      allow delete: if false;
    }

    match /loginAlerts/{alertId} {
      allow get: if isVerifiedUser() && isValidId(alertId) && isAdmin();
      allow list: if isVerifiedUser() && isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(alertId) &&
        isValidLoginAlert(alertId, incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().decision == 'pending' &&
        isAdmin();
      allow update: if isVerifiedUser() &&
        isValidId(alertId) &&
        isValidLoginAlert(alertId, incoming()) &&
        incoming().id == existing().id &&
        incoming().sessionId == existing().sessionId &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().deviceName == existing().deviceName &&
        incoming().platform == existing().platform &&
        incoming().timestampMillis == existing().timestampMillis &&
        incoming().createdAt == existing().createdAt &&
        isAdmin() && (
          // Action 1: Admin confirms or rejects a pending login alert
          (
            existing().decision == 'pending' &&
            incoming().decision in ['confirmed_me', 'rejected_not_me'] &&
            incoming().diff(existing()).affectedKeys().hasOnly(['decision', 'updatedAt'])
          ) ||
          // Action 2: Creator enriches approximate city/country on their own pending alert
          (
            existing().uid == request.auth.uid &&
            existing().decision == 'pending' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['location', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /adminLoginAttempts/{attemptId} {
      allow get: if isVerifiedUser() && isValidId(attemptId) && isAdmin();
      allow list: if isVerifiedUser() && isAdmin();
      allow create: if isValidId(attemptId) && isValidAdminLoginAttempt(attemptId, incoming());
      allow update, delete: if false;
    }

    match /pageVisits/{visitId} {
      allow get: if isVerifiedUser() && isValidId(visitId) && isAdmin();
      allow list: if isVerifiedUser() && isAdmin();
      allow create: if isValidId(visitId) && isValidPageVisit(visitId, incoming());
      allow update, delete: if false;
    }

    match /siteStats/{statId} {
      allow get: if isVerifiedUser() && isValidId(statId) && statId == 'visitors' && isAdmin();
      allow list: if false;
      allow create: if isValidId(statId) && statId == 'visitors' && isValidVisitorStatsCreate(incoming());
      allow update: if isValidId(statId) && statId == 'visitors' && isValidVisitorStatsUpdate(existing(), incoming());
      allow delete: if false;
    }
  }
}
